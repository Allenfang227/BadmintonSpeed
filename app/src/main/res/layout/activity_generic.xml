<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部标题栏（只有图标） -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="menu"
            app:tint="@color/green_neon" />

        <Space android:layout_width="1dp" android:layout_height="20dp" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_neon"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:text="@string/history_title" />

        <Space android:layout_width="1dp" android:layout_height="24dp" />

        <!-- 历史：日期筛选 + 全选 -->
        <LinearLayout
            android:id="@+id/history_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <Spinner
                android:id="@+id/spinner_dates"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_dark_card" />

            <Button
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:text="@string/history_select_all"
                android:textColor="@color/green_neon"
                android:background="@drawable/bg_btn_green_outline" />
        </LinearLayout>

        <!-- 设置：Switch 列表 -->
        <LinearLayout
            android:id="@+id/settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_virtual_court"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_virtual"
                android:textColor="@color/text_primary"
                android:padding="16dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_show_shot_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_shot_speed"
                android:textColor="@color/text_primary"
                android:padding="16dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_show_realtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_realtime"
                android:textColor="@color/text_primary"
                android:padding="16dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_show_hit_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_hit_type"
                android:textColor="@color/text_primary"
                android:padding="16dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_show_in_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_in_out"
                android:textColor="@color/text_primary"
                android:padding="16dp" />

        </LinearLayout>

        <!-- 教程：WebView-like 区域 -->
        <ScrollView
            android:id="@+id/tutorial_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="10dp"
                android:text="@string/tutorial_body" />
        </ScrollView>

        <!-- 关于 -->
        <LinearLayout
            android:id="@+id/about_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="杀球测速 v1.0"
                android:textColor="@color/green_neon"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Badminton Speed Detector"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="算法全部本地运行，不上传视频到云端"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 历史 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/repo_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 历史空占位 -->
        <LinearLayout
            android:id="@+id/history_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#1E3028" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/history_empty"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
