<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ========== 左侧：视频预览区（占 65%） ========== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="65"
        android:orientation="vertical">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="menu"
                app:tint="@color/green_neon" />

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/upload_title"
                android:textColor="@color/green_neon"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Space android:layout_width="48dp" android:layout_height="1dp" />
        </LinearLayout>

        <!-- 视频画面卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/left_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 上传初始视图 -->
                <LinearLayout
                    android:id="@+id/upload_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <!-- 绿色圆形上传图标 -->
                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_play_circle" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="#0A110D" />
                    </FrameLayout>

                    <Space android:layout_width="1dp" android:layout_height="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="不要使用广角、鱼眼镜头拍摄"
                        android:textColor="@color/green_bright"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="推荐使用帧率30FPS的视频"
                        android:textColor="@color/green_bright"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="慎用视频平台下载的被补帧、抽帧过的视频"
                        android:textColor="@color/green_bright"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center" />

                    <Space android:layout_width="1dp" android:layout_height="24dp" />

                    <Button
                        android:id="@+id/btn_upload"
                        android:layout_width="280dp"
                        android:layout_height="56dp"
                        android:text="@string/btn_upload_video"
                        android:textSize="18sp"
                        style="@style/BtnGreenOutline" />

                </LinearLayout>

                <!-- 视频处理中视图 -->
                <FrameLayout
                    android:id="@+id/processing_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <!-- 视频预览 SurfaceView -->
                    <SurfaceView
                        android:id="@+id/video_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- 场地线 / 球 / 人员叠加层（透明，绘制在视频上） -->
                    <com.badminton.speed.ui.OverlayView
                        android:id="@+id/overlay_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- 底部进度条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:layout_margin="10dp"
                        android:background="#CC0A110D"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_progress_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/progress_processing"
                                android:textColor="@color/green_neon"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_progress_pct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/green_neon"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_main"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0" />
                    </LinearLayout>
                </FrameLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <Space android:layout_width="10dp" android:layout_height="1dp" />

    <!-- ========== 右侧：算法模块状态面板（占 35%） ========== -->
    <LinearLayout
        android:id="@+id/right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="35"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="10dp">

        <!-- 算法列表（可滚动） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/repo_algo_modules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <!-- 开始测速按钮 -->
        <Button
            android:id="@+id/btn_start_analyze"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="▶  开始测速"
            style="@style/BtnGreenOutline"
            android:enabled="false" />

        <!-- 取消按钮 -->
        <LinearLayout
            android:id="@+id/bottom_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dark_card"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/green_neon" />

            <TextView
                android:id="@+id/tv_analyzing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/progress_analyzing"
                android:textColor="@color/green_neon"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_cancel"
                style="@android:style/Widget.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/progress_cancel"
                android:textColor="@color/red_alert" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
